                                  <Value>="Dirección: " &amp; First(Fields!Issuer_Address.Value, "Documento") &amp; IIF(Len(Trim(Replace(First(Fields!Issuer_Contact.Value, "Documento"),"|","")))=0,"",vbCrLf &amp; First(Fields!Issuer_Contact.Value, "Documento"))</Value>
