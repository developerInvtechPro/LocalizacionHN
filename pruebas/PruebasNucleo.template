    [Test]
    procedure CancellationRequiresFiscalReviewReference()
    var
        Header: Record "HN Retention Header";
        Cancellation: Codeunit "HN Retention Cancellation";
    begin
        Header."No." := 'HN-CANCEL-REPORTED';
        Header.Status := Header.Status::Posted;
        Header."Posting Date" := WorkDate();
        Header."Tax Reported" := true;
        Header.Insert(true);
        asserterror Cancellation.Cancel(Header, 'Error de importe', WorkDate(), '');
        Assert(StrPos(GetLastErrorText(), 'rectificación') > 0, 'Una retención declarada requiere tratamiento fiscal documentado.');
        Header.Get(Header."No.");
        Assert(Header.Status = Header.Status::Posted, 'Un fallo no debe anular parcialmente el documento.');
    end;

