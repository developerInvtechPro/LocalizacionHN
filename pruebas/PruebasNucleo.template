    local procedure PrepararFacturaSinRetencion(var Header: Record "HN Retention Header")
    var GL: Record "General Ledger Setup"; Factura: Record "Purch. Inv. Header"; FacturaLinea: Record "Purch. Inv. Line"; Fuente: Record "HN Retention Invoice"; Regla: Record "HN Retention Rule";
    begin
        if not GL.Get() then begin GL.Init(); GL.Insert(); end;
        GL."Amount Rounding Precision" := 0.01; GL.Modify(false);
        Header."No." := 'HN-TEST-RET-POST'; Header."Vendor No." := 'HN-TEST-VEND'; Header."Posting Date" := DMY2Date(31,12,2026); Header.Insert(true);
        Factura."No." := 'HN-TEST-INV-RET'; Factura."Pay-to Vendor No." := Header."Vendor No."; Factura."Posting Date" := DMY2Date(1,1,2026); Factura.Insert(false);
        FacturaLinea."Document No." := Factura."No."; FacturaLinea."Line No." := 10000; FacturaLinea.Type := FacturaLinea.Type::"G/L Account";
        FacturaLinea.Amount := 1000; FacturaLinea."Amount Including VAT" := 1150; FacturaLinea.Insert(false);
        Fuente."Document No." := Header."No."; Fuente."Invoice No." := Factura."No."; Fuente.Insert(true);
        Regla.Code := 'HN-TEST-MANUAL'; Regla.Percentage := 10; Regla.Enabled := true; Regla."G/L Account No." := 'HN-RET-FISCO'; Regla.Insert(true);
    end;

    local procedure PrepararCAIBoleta(var Autorizacion: Record "HN CAI Authorization")
    begin
        InitAuthorization(Autorizacion);
        Autorizacion."Document Type" := Autorizacion."Document Type"::BoletaCompra;
        Autorizacion."Starting No." := '999-999-11-00000001';
        Autorizacion."Ending No." := '999-999-11-00000100';
        Autorizacion."Next No." := Autorizacion."Starting No.";
    end;

    local procedure PrepararAutorizacionProveedor(var Autorizacion: Record "HN CAI Proveedor")
    begin
        Autorizacion.Init();
        Autorizacion."No. proveedor" := 'HN-PRUEBA-PROVEEDOR';
        Autorizacion.Codigo := 'HN-PRUEBA-CAI';
        Autorizacion.CAI := '123456-123456-123456-123456-123456-12';
        Autorizacion."Tipo documento" := Autorizacion."Tipo documento"::Factura;
        Autorizacion."Numero inicial" := '999-999-01-00000001';
        Autorizacion."Numero final" := '999-999-01-00000100';
        Autorizacion."Vigente desde" := DMY2Date(1, 1, 2026);
        Autorizacion."Fecha limite" := DMY2Date(31, 12, 2026);
        Autorizacion.Habilitado := true;
    end;

    local procedure InitAuthorization(var Authorization: Record "HN CAI Authorization")
    begin
        Authorization.Init();
        Authorization.Code := 'HN-TEST-CAI';
        Authorization."Document Type" := "HN Fiscal Document Type"::Retention;
        Authorization.CAI := '123456-123456-123456-123456-123456-12';
        Authorization."Starting No." := '999-999-05-00000001';
        Authorization."Ending No." := '999-999-05-00000100';
        Authorization."Next No." := Authorization."Starting No.";
        Authorization."Valid From" := DMY2Date(1, 1, 2026);
        Authorization."Valid Until" := DMY2Date(31, 12, 2026);
        Authorization.Enabled := true;
    end;

    local procedure IssueAndFail(Code: Code[20])
    var
        Management: Codeunit "HN CAI Management";
        Issued: Record "HN CAI Authorization";
        Number: Code[20];
    begin
        Number := Management.Issue(Code, "HN Fiscal Document Type"::Retention, DMY2Date(1, 12, 2026), Issued);
        Error('Fallo simulado después de asignar el correlativo %1.', Number);
    end;

