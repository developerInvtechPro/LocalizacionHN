        if not Datos.FieldExist(60450) then begin
            Gestion.ObtenerOpciones(Proveedor,Opciones);
            Assert(Opciones.Count()=1,'Sin la extensión anterior debe funcionar el RTN propio.'); exit;
        end;
        // La rama de convivencia solo puede ejecutarse con el paquete anterior instalado.
        Campo := Datos.Field(60450);
        Assert((Campo.Name='RTN') and (Campo.Type=FieldType::Code) and (Campo.Length=50),'La prueba requiere el esquema anterior verificado.');
        Metadatos.Get(Database::Vendor,60450); IdOrigen := 'ba215fdf-ea75-4dcd-875e-70dd8c5c9ff8';
        Aplicacion.SetRange("App ID",IdOrigen);
        Aplicacion.SetFilter("Package ID",'%1|%2',Metadatos."App Package ID",Metadatos."App Runtime Package ID");
        Assert(not Aplicacion.IsEmpty(),'La prueba de convivencia requiere el propietario esperado del RTN.');
        Datos.Get(Proveedor.RecordId); Campo := Datos.Field(60450); Campo.Value := '05011989042249'; Datos.Modify(false);
        // Se vacía el búfer tipado: el RTN anterior debe proceder del registro guardado.
        Clear(Proveedor); Proveedor.SetLoadFields("No.","HN RTN Proveedor","HN Ref 60450","VAT Registration No."); Proveedor.Get('HN-RTN-LECTURA');
        Gestion.ObtenerOpciones(Proveedor,Opciones); Opciones.SetRange(RTN,'05011989042249');
        Assert(Opciones.FindFirst(),'El RTN anterior guardado debe aparecer aunque no esté en los campos cargados por V2.');
        Assert(StrPos(Opciones.Origen,'Localización anterior')>0,'Debe conservar el origen del RTN anterior.');
        Proveedor.Get('HN-RTN-LECTURA');
        Assert(Proveedor."HN RTN Proveedor"='08019999123456','Consultar no debe sobrescribir el RTN propio.');
    end;

    [Test]
    procedure RetencionPermiteFinalizarRegistro()
    var Header: Record "HN Retention Header"; Guardado: Record "HN Retention Header";
    begin
        Header."No." := 'HN-TEST-FINALIZAR'; Header.Insert(true);
        Header.Status := Header.Status::Posted;
        Header."Registered At" := CurrentDateTime();
        Header.Modify(true);
        Guardado.Get(Header."No.");
        Assert(Guardado.Status=Guardado.Status::Posted,'Debe permitir finalizar el registro cuando la cabecera guardada aún es borrador.');
        Assert(Guardado."Registered At"=Header."Registered At",'Debe persistir la información de registro en la misma modificación.');
    end;

    [Test]
    procedure RetencionRegistradaSigueInmutable()
    var Header: Record "HN Retention Header"; Guardado: Record "HN Retention Header";
    begin
        Header."No." := 'HN-TEST-INMUTABLE'; Header.Status := Header.Status::Posted; Header.Insert(false);
        Header."Vendor Name" := 'CAMBIO NO PERMITIDO';
        asserterror Header.Modify(true);
        Guardado.Get(Header."No.");
        Assert(Guardado."Vendor Name"='','Debe impedir cambios en cabeceras ya registradas.');
    end;

    [Test]
    procedure RetencionBloqueaBufferDesactualizado()
    var Borrador: Record "HN Retention Header"; OtraSesion: Record "HN Retention Header";
    begin
        Borrador."No." := 'HN-TEST-BUFFER'; Borrador.Insert(true);
        OtraSesion.Get(Borrador."No."); OtraSesion.Status := OtraSesion.Status::Posted; OtraSesion.Modify(true);
        Borrador."Vendor Name" := 'BORRADOR DESACTUALIZADO';
        asserterror Borrador.Modify(true);
        OtraSesion.Get(Borrador."No.");
        Assert(OtraSesion.Status=OtraSesion.Status::Posted,'Un búfer que aún dice borrador no debe sobrescribir el estado registrado.');
        Assert(OtraSesion."Vendor Name"='','Debe conservar los datos del registro guardado.');
    end;

    [Test]
    procedure LetrasMonedaDocumentoUSD()
    var Letras: Codeunit "HN Importe En Letras"; Texto: Text;
    begin
        Texto := Letras.ConvertirMoneda(126.50,'USD');
        Assert(StrPos(Texto,'DÓLARES ESTADOUNIDENSES')>0,'Un documento USD debe expresarse en dólares.');
        Assert(StrPos(Texto,'LEMPIRAS')=0,'No debe rotular moneda extranjera como lempiras.');
        Assert(StrPos(Texto,'50/100')>0,'Debe conservar dos posiciones de centavos.');
    end;

    [Test]
    procedure LetrasImporteNegativoYRedondeo()
    var Letras: Codeunit "HN Importe En Letras"; Texto: Text;
    begin
        Texto := Letras.ConvertirMoneda(-1.999,'HNL');
        Assert(Texto='MENOS DOS LEMPIRAS CON 00/100','Debe redondear antes de separar entero y centavos.');
        Texto := Letras.ConvertirMoneda(1,'EUR');
        Assert(StrPos(Texto,'EUROS')>0,'No debe heredar la moneda del diseño anterior.');
    end;

    [Test]
    procedure RetencionGeneraTipoPago()
    var Header: Record "HN Retention Header"; Linea: Record "HN Retention Line"; Diario: Record "Gen. Journal Line"; Gestion: Codeunit "HN Retention Management";
    begin
        PrepararTipoDocumentoRetencion(Header,Linea);
        Gestion.InitJournal(Diario,Header,Linea,Header."Posting Date",876.49);
        Assert(Diario."Document Type"=Diario."Document Type"::Payment,'La retención debe generar un movimiento tipo Pago.');
        Assert(Diario."Account Type"=Diario."Account Type"::Vendor,'Debe seguir afectando al proveedor.');
        Assert(Diario."Bal. Account No."=Linea."G/L Account No.",'La contrapartida debe conservar la cuenta de retención.');
        Assert(Diario."External Document No."=Header."Fiscal No.",'Debe conservar el número fiscal del comprobante.');
    end;

    [Test]
    procedure AnulacionRetencionGeneraReembolso()
    var Header: Record "HN Retention Header"; Linea: Record "HN Retention Line"; Diario: Record "Gen. Journal Line"; Gestion: Codeunit "HN Retention Management";
    begin
        PrepararTipoDocumentoRetencion(Header,Linea);
        Gestion.InitJournal(Diario,Header,Linea,Header."Posting Date",-876.49);
        Assert(Diario."Document Type"=Diario."Document Type"::Refund,'La compensación debe generar Reembolso para admitir el signo negativo.');
        Assert(Diario.Amount=-876.49,'Clasificar el documento no debe invertir nuevamente su importe.');
        Assert(Diario."External Document No."=Header."Fiscal No.",'La compensación debe conservar el vínculo fiscal.');
    end;

    local procedure PrepararTipoDocumentoRetencion(var Header: Record "HN Retention Header"; var Linea: Record "HN Retention Line")
    var Configuracion: Record "General Ledger Setup"; Origenes: Record "Source Code Setup"; Origen: Record "Source Code";
        Proveedor: Record Vendor; Cuenta: Record "G/L Account";
    begin
        if not Configuracion.Get() then begin Configuracion.Init(); Configuracion.Insert(false); end;
        Configuracion."Amount Rounding Precision" := 0.01; Configuracion."LCY Code" := 'HNL'; Configuracion.Modify(false);
        Origen.Code := 'HN-DOCTEST'; Origen.Insert(false);
        if not Origenes.Get() then begin Origenes.Init(); Origenes.Insert(false); end;
        Origenes."General Journal" := Origen.Code; Origenes.Modify(false);
        Proveedor."No." := 'HN-TEST-TIPODOC'; Proveedor.Name := 'Proveedor de pruebas'; Proveedor.Insert(false);
        Cuenta."No." := 'HN-TEST-CUENTARET'; Cuenta."Direct Posting" := true; Cuenta.Insert(false);
        Header."No." := 'HN-TEST-DOCPAGO'; Header."Vendor No." := Proveedor."No.";
        Header."Posting Date" := DMY2Date(27,10,2026); Header."Fiscal No." := '999-999-05-00000001';
        Linea."G/L Account No." := Cuenta."No."; Linea."Retention Code" := 'TEST'; Linea."Vendor Invoice No." := 'FACTURA-TEST';
    end;

