    [Test]
    procedure ImporteBoletaEnLetras()
    var Letras: Codeunit "HN Importe En Letras";
    begin
        Assert(Letras.Convertir(0) = 'CERO LEMPIRAS CON 00/100', 'Debe convertir cero.');
        Assert(Letras.Convertir(1234.56) = 'MIL DOSCIENTOS TREINTA Y CUATRO LEMPIRAS CON 56/100', 'Debe incluir lempiras y centavos.');
        Assert(Letras.Convertir(1000000) = 'UN MILLÓN DE LEMPIRAS CON 00/100', 'Debe convertir millones.');
        Assert(Letras.Convertir(99.999) = 'CIEN LEMPIRAS CON 00/100', 'Debe redondear al centavo antes de separar enteros.');
    end;

