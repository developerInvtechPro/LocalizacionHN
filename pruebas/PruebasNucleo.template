    [Test]
    procedure LastNumberCanBeIssuedExactlyOnce()
    var
        Management: Codeunit "HN CAI Management";
        Authorization: Record "HN CAI Authorization";
        Issued: Record "HN CAI Authorization";
        Number: Code[20];
    begin
        InitAuthorization(Authorization);
        Authorization."Ending No." := Authorization."Next No.";
        Authorization.Insert(true);
        Number := Management.Issue(Authorization.Code, "HN Fiscal Document Type"::Retention, DMY2Date(1, 12, 2026), Issued);
        Assert(Number = Authorization."Ending No.", 'Debe permitir utilizar el último número.');
        Issued.Get(Authorization.Code);
        Assert(not Issued.Enabled, 'Debe deshabilitar la autorización agotada.');
        asserterror Issued.Validate(Enabled, true);
        asserterror Number := Management.Issue(Authorization.Code, "HN Fiscal Document Type"::Retention, DMY2Date(1, 12, 2026), Issued);
    end;

