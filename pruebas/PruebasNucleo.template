    [Test]
    procedure VentasAutomaticasSinMarcarDocumento()
    var Configuracion: Record "HN Config. Facturacion"; Cabecera: Record "Sales Header"; Gestion: Codeunit "HN Gestion Facturacion";
    begin
        if not Configuracion.Get('') then begin Configuracion.Init(); Configuracion.Insert(); end;
        Configuracion."Ventas habilitadas" := true;
        Configuracion."Activar documentos nuevos" := false;
        Configuracion.Modify();
        Cabecera."Document Type" := Cabecera."Document Type"::Order;
        Assert(Gestion.DebeEmitir(Cabecera), 'El pedido no debe requerir aplicar facturación.');
        Cabecera."Document Type" := Cabecera."Document Type"::Invoice;
        Assert(Gestion.DebeEmitir(Cabecera), 'La factura directa no debe requerir aplicación manual.');
        Cabecera."INV POS Transaction No." := '999-999-01-00000001';
        Assert(not Gestion.DebeEmitir(Cabecera), 'No debe emitir de nuevo una venta POS.');
        Clear(Cabecera."INV POS Transaction No.");
        Cabecera."HN Debit Note" := true;
        Assert(not Gestion.DebeEmitir(Cabecera), 'La nota de débito conserva su propio tipo fiscal.');
    end;

    [Test]
    procedure ResolverCAIVigenteSinReservar()
    var Configuracion: Record "HN Config. Facturacion"; Cabecera: Record "Sales Header"; Gestion: Codeunit "HN Gestion Facturacion";
    begin
        if not Configuracion.Get('') then begin Configuracion.Init(); Configuracion.Insert(); end;
        Configuracion."Ventas habilitadas" := true;
        Configuracion."CAI facturas" := 'ACTUAL';
        Configuracion.Modify();
        Cabecera."Document Type" := Cabecera."Document Type"::Invoice;
        Cabecera."HN CAI Code" := 'ANTERIOR';
        Gestion.PrepararDocumento(Cabecera);
        Assert(Cabecera."HN CAI Code" = 'ACTUAL', 'La configuración vigente debe sustituir un CAI anterior del borrador.');
        Assert(Cabecera."HN Fiscal No." = '', 'Resolver el CAI no asigna correlativo.');
        Assert(Cabecera."External Document No." = '', 'No debe reservar el fiscal como referencia externa.');
    end;

