    [Test]
    procedure HistoricalCAIMappingUsesActualSourceIDs()
    var
        Mapping: Codeunit "HN Migration Field Map";
        Map: Record "HN Migration Field" temporary;
    begin
        Mapping.Fill(36, Map);
        Assert(Map.Get(60100), 'La cabecera abierta usa el ID 60100 para el CAI completo.');
        Assert(Map."Target ID" = 71115, 'El CAI completo debe conservar un destino estable.');
        Mapping.Fill(112, Map);
        Assert(Map.Get(60460), 'La factura registrada usa un ID de CAI distinto del abierto.');
        Assert(Map."Target ID" = 71115, 'Ambos CAI deben ir al mismo concepto, sin copiar por ID entre tablas.');
    end;

