    [Test]
    procedure CalculateNetOnBilledAmount()
    var
        Management: Codeunit "HN Retention Management";
        Rule: Record "HN Retention Rule";
    begin
        Rule.Percentage := 12.5;
        Rule."Minimum Base" := 100;
        Rule."Calculation Base" := Rule."Calculation Base"::Net;
        Assert(Management.CalculateAmount(Rule, 200, 30, 0.01) = 25, 'Debe calcular sobre la base facturada.');
        Assert(Management.CalculateAmount(Rule, 99, 15, 0.01) = 0, 'Debe respetar el mínimo.');
        Assert(Management.CalculateAmount(Rule, 100, 15, 0.01) = 12.5, 'Debe incluir el mínimo exacto.');
    end;

    [Test]
    procedure CalculateOnTaxAndCurrencyRounding()
    var
