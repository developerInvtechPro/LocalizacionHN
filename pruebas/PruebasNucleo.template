        RefOrigen.GetTable(Origen); RefDestino.GetTable(Destino);
        for Indice := 1 to 4 do begin Mapa.Init(); Mapa."Source ID" := Indice; Mapa."Target ID" := Indice + 10; Mapa.Insert(); end;
        Assert(not Gestion.PrepararDestino(RefOrigen,RefDestino,Mapa), 'La referencia aún no existe.');
        for Indice := 1 to 4 do begin
            CampoOrigen := RefOrigen.Field(Indice); CampoDestino := RefDestino.Field(Indice+10);
