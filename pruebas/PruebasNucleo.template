    [Test]
    procedure CannotSelectInvoiceTwice()
    var
        Header: Record "HN Retention Header";
        Source: Record "HN Retention Invoice";
        Vendor: Record Vendor;
        Invoice: Record "Purch. Inv. Header";
        Management: Codeunit "HN Retention Management";
    begin
        Vendor."No." := 'HN-TEST-VENDOR';
        Vendor."HN Subject to Retention" := true;
        Vendor.Insert(false);
        Header."No." := 'HN-GROUP-DUP';
        Header."Vendor No." := Vendor."No.";
        Header.Insert(true);
        Source."Document No." := Header."No.";
        Source."Invoice No." := 'HN-TEST-INVOICE';
        Source.Insert(true);
        Invoice."No." := Source."Invoice No.";
