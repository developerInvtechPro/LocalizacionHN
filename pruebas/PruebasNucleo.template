    [Test]
    procedure FalloTrasEmitirBoletaRevierteCorrelativo()
    var Autorizacion: Record "HN CAI Authorization";
    begin
        PrepararCAIBoleta(Autorizacion); Autorizacion.Insert(true);
        asserterror EmitirBoletaYFallar(Autorizacion.Code);
        Autorizacion.Get(Autorizacion.Code);
        Assert(Autorizacion."Next No." = Autorizacion."Starting No.", 'Un fallo posterior no debe dejar un salto fiscal.');
        Assert(Autorizacion."Last Issued No." = '', 'El último emitido debe revertirse con el documento fallido.');
    end;

    local procedure EmitirBoletaYFallar(Codigo: Code[20])
    var Gestion: Codeunit "HN CAI Management"; Autorizacion: Record "HN CAI Authorization"; Numero: Code[20];
    begin
        Numero := Gestion.EmitirEnRegistro(Codigo, "HN Fiscal Document Type"::BoletaCompra, DMY2Date(1, 12, 2026), false, Autorizacion);
        Error('Fallo simulado posterior a %1.', Numero);
    end;

