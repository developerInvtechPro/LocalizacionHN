    [Test]
    procedure NormalizeSelectedCodes()
    var
        Management: Codeunit "HN Retention Management";
        Codes: List of [Text];
    begin
        Codes := Management.NormalizeCodes(' isr , honp ,, ');
        Assert(Codes.Count() = 2, 'Deben existir dos códigos.');
        Assert(Codes.Get(1) = 'ISR', 'Debe normalizar espacios y mayúsculas.');
    end;

