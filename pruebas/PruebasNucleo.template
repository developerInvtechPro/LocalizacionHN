    [Test]
    procedure ImporteBoletaEnLetras()
    var Letras: Codeunit "HN Importe En Letras";
    begin
        Assert(Letras.Convertir(0) = 'CERO LEMPIRAS CON 00/100', 'Debe convertir cero.');
